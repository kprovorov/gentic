# Hosted Gentic API endpoint and host identity issued by enrollment.
# Before 0.26.0 these two were named GENTIC_WORKER_ID and
# GENTIC_WORKER_CREDENTIAL; those names are still read, so an existing .env
# keeps working.
GENTIC_API_URL=http://localhost:3000/api/v1
GENTIC_HOST_ID=
GENTIC_HOST_CREDENTIAL=

# Base for cloning project repos (project.repo is appended, e.g. "user/repo").
GIT_REMOTE_BASE=git@github.com:

# Where fresh clones are created (one subdirectory per issue). Leave unset to
# use an OS-appropriate data directory (e.g. ~/.local/share/gentic/workspaces
# on Linux). Uncomment to override:
# WORKDIR=/tmp/gentic-workspaces

# How often (ms) to poll for issues that were moved to Todo.
POLL_INTERVAL_MS=3000

# Maximum number of issues this host may process at the same time. Each
# issue gets its own clone and realtime channel. Defaults to 1.
MAX_CONCURRENT_ISSUES=1
